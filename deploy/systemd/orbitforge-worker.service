[Unit]
Description=OrbitForge read-only station readiness worker
Documentation=file:/opt/orbitforge/current/docs/operations/install-milestone-1.md
After=local-fs.target
StartLimitIntervalSec=60s
StartLimitBurst=5
ConditionPathExists=/opt/orbitforge/current/apps/worker/dist/main.cjs
RequiresMountsFor=/run/orbitforge

[Service]
Type=simple
User=orbitforge-worker
Group=orbitforge-worker
SupplementaryGroups=orbitforge
WorkingDirectory=/opt/orbitforge/current
EnvironmentFile=/etc/orbitforge/worker.env
Environment=ORBITFORGE_WORKER_SOCKET=/run/orbitforge/worker.sock
Environment=ORBITFORGE_SATDUMP_BINARY=/usr/bin/satdump
Environment=ORBITFORGE_SATDUMP_CONFIG=/home/vaggos/autotracking_config.json
Environment=ORBITFORGE_SATDUMP_SERVICE=satdump-autotrack.service
ExecStart=/usr/local/bin/node /opt/orbitforge/current/apps/worker/dist/main.cjs
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
UMask=0007

NoNewPrivileges=true
CapabilityBoundingSet=
PrivateMounts=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=read-only
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/home/vaggos/autotracking_config.json
ReadWritePaths=/run/orbitforge
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native

StandardOutput=journal
StandardError=journal
SyslogIdentifier=orbitforge-worker

[Install]
WantedBy=multi-user.target
